          "raw": "{\n  \"email\": \"{{affiliateEmail}}\",\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Affiliate\",\n  \"phoneNumber\": \"{{affiliatePhone}}\",\n  \"password\": \"{{affiliatePassword}}\",\n  \"confirmPassword\": \"{{affiliatePassword}}\",\n  \"country\": \"KE\",\n  \"termsAccepted\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/signup",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "signup"]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Signup 201 with JWT\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"affiliateAccessToken\", pm.response.json().accessToken);"
