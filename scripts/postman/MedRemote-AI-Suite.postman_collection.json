      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Referral code 200 and 6-char uppercase\", function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.code).to.match(/^[A-Z0-9]{6,12}$/);",
              "    pm.collectionVariables.set(\"referralCode\", json.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
