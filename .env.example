# ============================================================
# MedRemote Backend — Environment Template (.env.example)
# Copy this to backend/.env and fill in real values.
# NEVER commit the real .env.
# ============================================================

# ---------- Core ----------
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
JWT_SECRET=please-change-this-to-a-long-random-string-32chars-min
JWT_REFRESH_SECRET=please-change-this-refresh-secret-too

# ---------- Database (Prisma MySQL or local dev Postgres/SQLite OK) ----------
# For quick local validation use sqlite:
# DATABASE_URL="file:./dev.db"
DATABASE_URL="mysql://root:password@localhost:3306/medremote_dev"
REDIS_URL=

# ---------- M-Pesa Daraja (Safaricom) — ALWAYS Primary payment ----------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=4082347
MPESA_PASSKEY=
# MPESA_ENV=sandbox or production
MPESA_ENV=sandbox

# ---------- Paystack Card + M-Pesa Paybill fallback ----------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---------- LLM ----------
# Provider selection: auto | openai | anthropic | gemini | mock
#   auto ~ picks first configured key (openai -> anthropic -> gemini), else mock.
#   mock ~ canned offline responses (no key needed, good for dev/tests).
LLM_PROVIDER=auto
OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------- Google OAuth (Sign in with Google) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- LinkedIn OAuth (Sign in with LinkedIn) ----------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# ---------- Africa's Talking SMS — Wired but default OFF below ----------
# To send real SMS: set SMS_ENABLED=true + SMS_PROVIDER=africastalking + fill below
SMS_ENABLED=false
SMS_PROVIDER=log
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# ---------- Twilio SMS (future swap — stub adapter included) ----------
# To swap Africa's Talking → Twilio: SMS_PROVIDER=twilio + fill below
# (0 edits to billing/notifications required — just env flip)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
