{
  "name": "medremote-backend",
  "version": "1.0.0",
  "description": "MedRemote AI Suite backend (Express 5 + Prisma 5). A resume builder + matching engine + 1-click apply + M-Pesa billing for Kenyan medical & HVAC job seekers.",
  "main": "dist/src/server.js",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:deploy": "prisma migrate deploy",
    "scrape": "tsx scripts/cron.ts",
    "match:worker": "tsx scripts/match-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"test/integration/**/*.test.ts\"",
    "test:smoke": "tsx scripts/admin-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "africastalking": "^0.7.5",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.1.1",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "openai": "^4.85.3",
    "paystack": "^2.0.1",
    "pdfmake": "^0.2.18",
    "playwright": "^1.63.0",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/node-cron": "^3.0.11",
    "@types/paystack": "^2.0.5",
    "@types/pdfmake": "^0.2.11",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
