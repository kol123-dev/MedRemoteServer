# ============================================================
# MedRemote Backend — PRODUCTION Env Template (.env.production.example)
# On the server: cp .env.production.example .env  then fill in real values.
# The real .env is git-ignored and must NEVER be committed.
# ============================================================

# ---------- Core ----------
NODE_ENV=production
# >>> CHOOSE A PORT THAT IS FREE ON YOUR SERVER (e.g. 8010) <<<
# Check what's in use first:  sudo ss -tlnp  | grep <port>
PORT=8010
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://api.your-backend-domain.com
# If behind an nginx reverse proxy, set to number of proxy hops (usually 1).
TRUST_PROXY_HOPS=1
# Comma-separated additional CORS origins if your frontend is not FRONTEND_URL.
CORS_ORIGINS_ADDITIONAL=
# Set to false only if you ever serve API over plain HTTP.
COOKIE_SECURE_IN_PRODUCTION=true

# ---------- Auth secrets (REQUIRED — generate strong random strings) ----------
# Generate:  openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_32_PLUS_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING_32_PLUS_CHARS

# ---------- Database (create a DEDICATED MySQL DB on the server) ----------
#   mysql> CREATE DATABASE medremote_prod CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   mysql> CREATE USER 'medremote'@'localhost' IDENTIFIED BY 'STRONG_PASSWORD';
#   mysql> GRANT ALL PRIVILEGES ON medremote_prod.* TO 'medremote'@'localhost';
DATABASE_URL=mysql://medremote:STRONG_PASSWORD@127.0.0.1:3306/medremote_prod
REDIS_URL=

# ---------- M-Pesa Daraja (Safaricom) — PRIMARY payment ----------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=4082347
MPESA_PASSKEY=
MPESA_ENV=sandbox          # switch to production with a live shortcode

# ---------- Paystack Card fallback ----------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ---------- LLM (auto picks first configured key) ----------
LLM_PROVIDER=auto          # auto | openai | anthropic | gemini | mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Admin secret-encryption key (REQUIRED, >=32 chars) ----------
# Used to encrypt LLM keys / secret config values stored via the admin UI.
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_32_PLUS_CHAR_PRODUCTION_KEY

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- SMS (default off) ----------
SMS_ENABLED=false
SMS_PROVIDER=log
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=